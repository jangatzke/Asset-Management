# ============================================================================
# Asset Management ISMS – Production Docker Environment
#
# Copy this file to `.env.production` and fill in the required values.
# Use `docker compose --env-file .env.production up -d` to start the stack.
#
# For Portainer:
#   - Create the .env.production file on the host
#   - Or set environment variables in the Portainer stack configuration
# ============================================================================

# ---------------------------------------------------------------------------
# Required – Database
# ---------------------------------------------------------------------------
POSTGRES_DB=asset_management
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---------------------------------------------------------------------------
# Required – JWT (generate with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-32-byte-hex-secret

# ---------------------------------------------------------------------------
# Optional – Database (defaults shown)
# ---------------------------------------------------------------------------
# JWT_ACCESS_TOKEN_EXPIRES_IN=20m
# JWT_REFRESH_TOKEN_EXPIRES_IN=7d
# REFRESH_TOKEN_COOKIE_NAME=refreshToken
# REFRESH_TOKEN_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Optional – CORS (comma-separated list of allowed origins)
# ---------------------------------------------------------------------------
# CORS_ORIGINS=https://your-domain.example.com

# ---------------------------------------------------------------------------
# Optional – Rate Limiting
# ---------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX=20
# REFRESH_RATE_LIMIT_MAX=120
# SERVICE_ACCOUNT_AUTH_RATE_LIMIT_MAX=60

# ---------------------------------------------------------------------------
# Optional – File Upload
# ---------------------------------------------------------------------------
# MAX_FILE_SIZE=10485760
# BACKUP_MAX_FILE_SIZE_MB=50

# ---------------------------------------------------------------------------
# Optional – Encryption Keys (generate with: openssl rand -hex 16)
# Required when using VMware/Proxmox integrations or MFA
# ---------------------------------------------------------------------------
# VMWARE_ENCRYPTION_KEY=
# PROXMOX_ENCRYPTION_KEY=
# MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Optional – Health & Metrics
# ---------------------------------------------------------------------------
# METRICS_TOKEN=
# HEALTH_CHECK_NETWORK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Optional – Webhook
# ---------------------------------------------------------------------------
# WEBHOOK_SIGNATURE_SECRET=
# WEBHOOK_SIGNATURE_MAX_AGE_MS=300000
# WEBHOOK_QUEUE_POLL_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# Optional – Redis (if using a separate Redis instance)
# ---------------------------------------------------------------------------
# REDIS_PASSWORD=
# REDIS_DB=0

# ---------------------------------------------------------------------------
# Optional – Intune Integration
# ---------------------------------------------------------------------------
# INTUNE_ENABLED=false
# INTUNE_TENANT_ID=
# INTUNE_APP_ID=
# INTUNE_CERT_PRIVATE_KEY_SECRET_REF=
# INTUNE_CERT_X5C_SECRET_REF=
# INTUNE_CERT_THUMBPRINT=
# INTUNE_APP_NAME=Asset-Management
# INTUNE_FULL_SYNC_INTERVAL=24
# INTUNE_INCREMENTAL_SYNC_INTERVAL=120
# INTUNE_GRACE_PERIOD_HOURS=168
# INTUNE_MAX_RETRY_ATTEMPTS=3
# INTUNE_RETRY_DELAY_MS=5000
# INTUNE_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Optional – Frontend Port (default: 8080)
# ---------------------------------------------------------------------------
# FRONTEND_PORT=8080
