{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "isolatedModules": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/src/*"],
      "shared": ["../shared/dist/index"],
      "shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
