{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend für IT-Asset-Management und ISMS-System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/with-backend-env.cjs tsx watch src/index.ts",
    "build": "tsc",
    "start": "node scripts/with-backend-env.cjs node dist/index.js",
    "pretest": "npm --workspace=shared run build && node scripts/with-backend-env.cjs prisma generate",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node scripts/with-backend-env.cjs prisma migrate dev",
    "db:deploy": "node scripts/with-backend-env.cjs prisma migrate deploy",
    "db:seed": "node scripts/with-backend-env.cjs tsx prisma/seed.ts",
    "db:generate": "node scripts/with-backend-env.cjs prisma generate",
    "db:setup:cost-planning": "node scripts/with-backend-env.cjs prisma migrate deploy && node scripts/with-backend-env.cjs prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.2",
    "@prisma/client": "^5.7.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "otplib": "^12.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "shared": "file:../shared",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
