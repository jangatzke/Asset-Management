model IncidentHistoryEntry {
  id           String   @id @default(uuid())
  incidentId   String
  action       String // CREATE, UPDATE, DELETE, STATUS_CHANGE, ASSESSMENT, KNOWLEDGE_TIME_CHANGE, CLOSE
  fieldChanges String? @db.NVarChar(Max) // { "field": { "old": ..., "new": ... }[] }
  summary      String? // human-readable summary of the change
  actorId      String? // user who performed the action
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([incidentId, createdAt])
  @@index([action])
  @@map("incident_history_entries")
}

