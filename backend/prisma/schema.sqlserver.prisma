  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?

  risks Risk[] @relation("ProcessRisks")

  // Junction table links for M:N relationships
  assetLinks      AssetProcess[]
  RiskProcess     RiskProcess[]
  IncidentProcess IncidentProcess[]
  ControlProcess  ControlProcess[]

  @@map("business_processes")
}

// ==========================================
// Junction Tables (Many-to-Many Relations)
// ==========================================

model AssetDocument {
  id         String @id @default(uuid())
  assetId    String
  documentId String

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document Document @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, documentId])
  @@map("asset_documents")
}

// Risk-Asset junction table (replaces affectedAssetIds array in Risk)
model RiskAsset {
  id      String @id @default(uuid())
  riskId  String
  assetId String

  risk  Risk  @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([riskId, assetId])
  @@map("risk_assets")
}

// Vulnerability-Asset junction table
model VulnerabilityAsset {
  id              String @id @default(uuid())
  vulnerabilityId String
  assetId         String

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vulnerabilityId, assetId])
  @@map("vulnerability_assets")
}

// Incident-Asset junction table
model IncidentAsset {
  id         String @id @default(uuid())
  incidentId String
  assetId    String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([incidentId, assetId])
  @@map("incident_assets")
}

// Asset-Process junction table (NEW — replaces businessProcessId FK on Asset for M:N)
model AssetProcess {
  id        String @id @default(uuid())
  assetId   String
  processId String

  asset   Asset           @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  process BusinessProcess @relation(fields: [processId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, processId])
  @@map("asset_processes")
}

// Asset-Service junction table (NEW — replaces serviceId FK on Asset for M:N)
model AssetService {
  id        String @id @default(uuid())
  assetId   String
  serviceId String

  asset   Asset           @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service BusinessService @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, serviceId])
  @@map("asset_services")
}

// Asset-Contract junction table (NEW — replaces contractId FK on Asset for M:N)
model AssetContract {
  id         String @id @default(uuid())
  assetId    String
  contractId String

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, contractId])
  @@map("asset_contracts")
}

// Asset-License junction table (NEW — replaces licenseId FK on Asset for M:N)
model AssetLicense {
  id        String @id @default(uuid())
  assetId   String
  licenseId String

  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  license License @relation(fields: [licenseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, licenseId])
  @@map("asset_licenses")
}

