model Incident {
  id                        String    @id @default(uuid())
  displayId                 String    @unique
  title                     String
  description               String
  detectionTime             DateTime
  knowledgeTime             DateTime
  reporterId                String?
  reporterSource            String?
  // affectedAssetIds removed — use IncidentAsset junction table only
  // affectedServiceIds removed — use IncidentService junction table
  // affectedProcessIds removed — use IncidentProcess junction table
  confidentialityImpact     String    @default("none")
  integrityImpact           String    @default("none")
  availabilityImpact        String    @default("none")
  operationalImpact         String?
  financialImpact           Decimal?
  legalImpact               String?
  personalDataImpact        Boolean   @default(false)
  affectedCustomers         String @default("[]") @db.NVarChar(Max)
  affectedThirdParties      String @default("[]") @db.NVarChar(Max)
  suspectedCause            String?
  isIntentional             Boolean?
  hasCrossBorderImpact      Boolean?
  indicatorsOfCompromise    String @default("[]") @db.NVarChar(Max)
  immediateActions          String @default("[]") @db.NVarChar(Max)
  incidentManagerId         String
  status                    String    @default("new")
  severity                  String    @default("low")
  notificationStatus        String    @default("not_required")
  significanceRuleVersionId String?
  isSignificant             Boolean   @default(false)
  significanceReasons       String @default("[]") @db.NVarChar(Max)
  rootCause                 String?
  lessonsLearned            String?
  measuresEvaluation        String?
  closureSummary            String?
  closedAt                  DateTime?
  closedBy                  String?
  version                   String    @default("1.0.0")
  isArchived                Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  createdBy                 String?
  updatedBy                 String?

  incidentAssets IncidentAsset[]

  // Junction table links for M:N relationships (replaces ID arrays)
  serviceLinks            IncidentService[]
  processLinks            IncidentProcess[]
  significanceRuleVersion Nis2IncidentSignificanceRuleVersion? @relation(fields: [significanceRuleVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeTimeChanges    IncidentKnowledgeTimeChange[]
  assessments             IncidentAssessment[]
  notificationDeadlines   NotificationDeadline[]
  reports                 IncidentReport[]
  communications          IncidentCommunication[]
  escalations             IncidentEscalation[]
  historyEntries          IncidentHistoryEntry[]

  @@index([significanceRuleVersionId])
  @@map("incidents")
}

model IncidentAssessment {
  id                        String    @id @default(uuid())
