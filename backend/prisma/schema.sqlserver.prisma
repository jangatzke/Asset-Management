  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  assetLinks    AssetContract[]
  licenseLinks  ContractLicense[]
  costPlanItems CostPlanItem[]

  @@map("contracts")
}

model License {
  id          String    @id @default(uuid())
