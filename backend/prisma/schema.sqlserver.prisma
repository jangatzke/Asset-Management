model FrameworkVersion {
  id              String    @id @default(uuid())
  frameworkId     String
  version         String
  publicationDate DateTime?
  importedAt      DateTime  @default(now())
  source          String?
  licenseInfo     String?
  changelog       String?
  isActive        Boolean   @default(true)
  isImmutable     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  createdBy       String?

