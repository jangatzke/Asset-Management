  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([controlId, requirementId])
  @@index([requirementId])
  @@map("control_requirement_mappings")
}

model Control {
  id                         String    @id @default(uuid())
  catalogId                  String
  catalogVersion             String
  title                      String
  description                String
  controlGoal                String
  responsibleId              String?
  applicability              String    @default("under_review")
  applicabilityJustification String?
  implementationStatus       String    @default("planned")
  maturityLevel              Int       @default(0)
  implementationDescription  String?
  // affectedAssetIds removed — use ControlAsset junction table
  // affectedProcessIds removed — use ControlProcess junction table
  // affectedSiteIds removed — use ControlSite junction table
  // direct risk-control links removed — use RiskControl via ControlImplementation
  // evidenceIds removed — use generic EvidenceLink
  testMethod                 String?
  testFrequency              String?
  lastEffectivenessReview    DateTime?
  nextTestDate               DateTime?
