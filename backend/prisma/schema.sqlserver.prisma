generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==========================================
// Identity & Access Management
// ==========================================

model User {
  id                       String    @id @default(uuid())
  displayId                String    @unique @default("")
  email                    String    @unique
  passwordHash             String
  firstName                String
  lastName                 String
  phoneNumber              String?
  isActive                 Boolean   @default(true)
  lastLoginAt              DateTime?
  mustChangePasswordOnNext Boolean   @default(false)
  passwordChangedAt        DateTime  @default(now())
  organizationUnitId       String?
  isArchived               Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdBy                String?
  updatedBy                String?

  // OIDC / Entra ID fields
  oidcId       String?
  oidcProvider String?

  // Local account MFA / TOTP fields
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaPendingSecret String?
  mfaEnabledAt     DateTime?

  // User preferences
  language String?  @default("en")
  darkMode Boolean?

  organizationUnit       OrganizationUnit?  @relation("UserOrgUnit", fields: [organizationUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles              UserRole[]         @relation("UserRoles")
  userGroups             UserGroup[]        @relation("UserGroups")
  ServiceAccount         ServiceAccount[]
  fiscalYearUpdates      FiscalYearConfig[] @relation("FiscalYearConfigUpdatedBy")
  ownedCostPlans         CostPlan[]         @relation("CostPlanOwner")
  completedCostPlanItems CostPlanItem[]     @relation("CostPlanItemCompletedBy")
  passwordHistory        PasswordHistory[]  @relation("UserPasswordHistory")
  refreshTokens          RefreshToken[]     @relation("UserRefreshTokens")
  preAuthChallenges      PreAuthChallenge[] @relation("UserPreAuthChallenges")
  oidcAccountLinks       OidcAccountLink[]  @relation("UserOidcAccountLinks")

  @@index([oidcId, oidcProvider])
  @@map("users")
}

model AuthSettings {
  id                        String   @id @default(uuid())
  passwordComplexityEnabled Boolean  @default(true)
  minPasswordLength         Int      @default(12)
  passwordHistoryCount      Int      @default(0)
  passwordValidityDays      Int      @default(0)
  forceMfa                  Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?

  @@map("auth_settings")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation("UserPasswordHistory", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@map("password_history")
}

model UserRole {
  id                 String    @id @default(uuid())
  userId             String
  roleName           String
  roleId             String?
  legalEntityId      String?
  organizationUnitId String?
  scopeId            String?
  siteId             String?
  validFrom          DateTime  @default(now())
  validUntil         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User              @relation("UserRoles", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role             Role?             @relation("RoleUsers", fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalEntity      LegalEntity?      @relation("UserRoleLegalEntity", fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationUnit OrganizationUnit? @relation("UserRoleOrgUnit", fields: [organizationUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scope            IsmsScope?        @relation("UserRoleIsmsScope", fields: [scopeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site             Site?             @relation("UserRoleSite", fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, roleName])
  @@index([legalEntityId])
  @@index([organizationUnitId])
  @@index([scopeId])
  @@index([siteId])
  @@map("user_roles")
}

model Role {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  isBuiltIn         Boolean  @default(false)
  permissions       String @default("{}") @db.NVarChar(Max)
  canAccessAdmin    Boolean  @default(false)
  entityPermissions String? @db.NVarChar(Max) // { assets: 'none'|'readonly'|'readwrite', risks: ..., controls: ..., incidents: ... }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userRoleAssignments  UserRole[]       @relation("RoleUsers")
  groupRoleAssignments GroupRole[]      @relation("GroupRoles")
  rolePermissions      RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userGroups UserGroup[] @relation("GroupUsers")
  groupRoles GroupRole[] @relation("GroupRoles")

  @@map("groups")
}

model UserGroup {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User  @relation("UserGroups", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group Group @relation("GroupUsers", fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, groupId])
  @@map("user_groups")
}

model GroupRole {
  id                 String    @id @default(uuid())
  groupId            String
  roleName           String
  roleId             String?
  legalEntityId      String?
  organizationUnitId String?
  scopeId            String?
  siteId             String?
  validFrom          DateTime  @default(now())
  validUntil         DateTime?
  createdAt          DateTime  @default(now())

  group            Group             @relation("GroupRoles", fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role             Role?             @relation("GroupRoles", fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalEntity      LegalEntity?      @relation("GroupRoleLegalEntity", fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationUnit OrganizationUnit? @relation("GroupRoleOrgUnit", fields: [organizationUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scope            IsmsScope?        @relation("GroupRoleIsmsScope", fields: [scopeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  site             Site?             @relation("GroupRoleSite", fields: [siteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([groupId, roleName])
  @@index([legalEntityId])
  @@index([organizationUnitId])
  @@index([scopeId])
  @@index([siteId])
  @@index([validFrom, validUntil])
  @@map("group_roles")
}

model OidcConfig {
  id                               String   @id @default(uuid())
  enabled                          Boolean  @default(false)
  providerName                     String   @default("entra_id")
  tenantId                         String?
  clientId                         String?
  clientSecretRef                  String?
  clientSecret                     String?
  redirectUri                      String?
  allowedEmailDomains              String @default("{}") @db.NVarChar(Max)
  autoProvisioning                 Boolean  @default(false)
  defaultRoleForNewUsers           String   @default("employee")
  enableGroupMapping               Boolean  @default(false)
  groupClaimToRoleMapping          String @default("{}") @db.NVarChar(Max)
  enableLocalLogin                 Boolean  @default(true)
  autoProvisioningRequiresApproval Boolean  @default(false)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  loginStates  OidcLoginState[]  @relation("OidcConfigLoginStates")
  accountLinks OidcAccountLink[] @relation("OidcConfigAccountLinks")

  @@map("oidc_configs")
}

model OidcLoginState {
  id           String    @id @default(uuid())
  oidcConfigId String
  stateHash    String    @unique
  nonce        String
  codeVerifier String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?

  oidcConfig OidcConfig @relation("OidcConfigLoginStates", fields: [oidcConfigId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([oidcConfigId, expiresAt])
  @@index([usedAt])
  @@map("oidc_login_states")
}

model OidcAccountLink {
  id           String   @id @default(uuid())
  oidcConfigId String
  providerName String
  subject      String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oidcConfig OidcConfig @relation("OidcConfigAccountLinks", fields: [oidcConfigId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User       @relation("UserOidcAccountLinks", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([oidcConfigId, subject])
  @@unique([providerName, subject])
  @@index([userId])
  @@map("oidc_account_links")
}

// ==========================================
// Organization & Scope
// ==========================================

model OrganizationUnit {
  id                String   @id @default(uuid())
  name              String
  description       String?
  parentId          String?
  type              String   @default("department")
  legalEntityId     String?
  responsibleUserId String?
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?
  updatedBy         String?

  parent                 OrganizationUnit?       @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children               OrganizationUnit[]      @relation("OrgUnitHierarchy")
  legalEntity            LegalEntity?            @relation("LegalEntityOrgUnits", fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  User[]                  @relation("UserOrgUnit")
  sites                  Site[]                  @relation("SiteOrgUnit")
  assets                 Asset[]                 @relation("AssetOrgUnit")
  risks                  Risk[]                  @relation("RiskOrgUnit")
  scopedUserRoles        UserRole[]              @relation("UserRoleOrgUnit")
  scopedGroupRoles       GroupRole[]             @relation("GroupRoleOrgUnit")
  controlImplementations ControlImplementation[] @relation("ControlImplementationOrgUnit")

  @@index([legalEntityId])
  @@map("organization_units")
}

model LegalEntity {
  id          String   @id @default(uuid())
  name        String
  description String?
  taxId       String?
  address     String?
  country     String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationUnits    OrganizationUnit[]     @relation("LegalEntityOrgUnits")
  ismsScopeMemberships IsmsScopeLegalEntity[]
  scopedUserRoles      UserRole[]             @relation("UserRoleLegalEntity")
  scopedGroupRoles     GroupRole[]            @relation("GroupRoleLegalEntity")

  @@map("legal_entities")
}

model Site {
  id                 String   @id @default(uuid())
  name               String
  address            String
  city               String
  postalCode         String?
  country            String
  organizationUnitId String?
  isCritical         Boolean  @default(false)
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?
  updatedBy          String?

  organizationUnit       OrganizationUnit?       @relation("SiteOrgUnit", fields: [organizationUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets                 Asset[]                 @relation("AssetLocation")
  ControlSite            ControlSite[]
  scopedUserRoles        UserRole[]              @relation("UserRoleSite")
  scopedGroupRoles       GroupRole[]             @relation("GroupRoleSite")
  controlImplementations ControlImplementation[] @relation("ControlImplementationSite")

  @@map("sites")
}

model IsmsScope {
  id                        String    @id @default(uuid())
  name                      String
  description               String
  includedCompanies         String @default("{}") @db.NVarChar(Max)
  includedLocations         String @default("{}") @db.NVarChar(Max)
  includedBusinessProcesses String @default("{}") @db.NVarChar(Max)
  includedServices          String @default("{}") @db.NVarChar(Max)
  includedAssets            String @default("{}") @db.NVarChar(Max)
  explicitExclusions        String @default("{}") @db.NVarChar(Max)
  exclusionJustifications   String @default("{}") @db.NVarChar(Max)
  responsibleUserId         String
  approvalStatus            String    @default("draft")
  validFrom                 DateTime  @default(now())
  validUntil                DateTime?
  nextReviewDate            DateTime
  version                   String    @default("1.0.0")
  isArchived                Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  createdBy                 String?
  updatedBy                 String?

  legalEntityMemberships IsmsScopeLegalEntity[]
  scopedUserRoles        UserRole[]              @relation("UserRoleIsmsScope")
  scopedGroupRoles       GroupRole[]             @relation("GroupRoleIsmsScope")
  controlImplementations ControlImplementation[] @relation("ControlImplementationScope")

  @@map("isms_scopes")
}

model IsmsScopeLegalEntity {
  id            String   @id @default(uuid())
  scopeId       String
  legalEntityId String
  createdAt     DateTime @default(now())

  scope       IsmsScope   @relation(fields: [scopeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([scopeId, legalEntityId])
  @@index([legalEntityId])
  @@map("isms_scope_legal_entities")
}

model InterestedParty {
  id            String   @id @default(uuid())
  name          String
  type          String
  requirements  String? @db.NVarChar(Max)
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?

  @@map("interested_parties")
}

// ==========================================
// Asset Management
// ==========================================

model AssetType {
  id                    String   @id @default(uuid())
  name                  String   @unique
  description           String?
  category              String
  inventoryEnabled      Boolean  @default(false)
  inventoryPattern      String?
  inventoryNextSequence Int      @default(1)
  isArchived            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  assets   Asset[]        @relation("AssetTypeRelation")
  subtypes AssetSubtype[]

  @@map("asset_types")
}

model AssetSubtype {
  id                    String   @id @default(uuid())
  assetTypeId           String
  name                  String
  description           String?
  inventoryEnabled      Boolean?
  inventoryPattern      String?
  inventoryNextSequence Int      @default(1)
  isArchived            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  assetType AssetType @relation(fields: [assetTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets    Asset[]

  @@unique([assetTypeId, name])
  @@index([assetTypeId])
  @@map("asset_subtypes")
}

model BusinessService {
  id           String   @id @default(uuid())
  displayId    String   @unique
  name         String
  description  String?
  serviceOwner String? // User ID
  category     String? // core, supporting, management
  criticality  String   @default("low")
  status       String   @default("active")
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  assetLinks      AssetService[]
  RiskService     RiskService[]
  IncidentService IncidentService[]

  @@map("business_services")
}

model Asset {
  id                               String  @id @default(uuid())
  displayId                        String  @unique
  name                             String
  description                      String?
  assetTypeId                      String
  assetSubtypeId                   String?
  inventoryNumber                  String? @unique
  subType                          String?
  manufacturer                     String?
  model                            String?
  serialNumber                     String?
  externalId                       String?
  organizationUnitId               String?
  locationId                       String?
  technicalOperatorId              String?
  businessOwnerId                  String?
  informationSecurityResponsibleId String?

  // Contract/License info (AST-002) — direct FKs removed, use junction tables
  licenseInfo      String?
  contractEndsAt   DateTime?
  licenseExpiresAt DateTime?

  // Extended rating dimensions (AST-004)
  personnelSafetyRelevance String @default("low") // low, medium, high
  regulatoryRelevance      String @default("low") // low, medium, high
  financialDamagePotential String @default("low") // low, medium, high
  productionDowntimeImpact String @default("low") // low, medium, high

  lifecycleStatus         String    @default("planned")
  purchaseDate            DateTime?
  commissioningDate       DateTime?
  endOfSaleDate           DateTime?
  endOfLifeDate           DateTime?
  endOfSupportDate        DateTime?
  confidentialityNeed     String    @default("low")
  integrityNeed           String    @default("low")
  availabilityNeed        String    @default("low")
  dataProtectionRelevance Boolean   @default(false)
  criticality             String    @default("low")
  complianceRelevance     Boolean   @default(false) // AST-004: compliance-relevant asset
  // networkAddresses and dnsNames removed — use NetworkAddress model
  archivedAt              DateTime? // Soft-delete timestamp (null = active)
  disposalDate            DateTime? // AST-031: date of physical/logical disposal
  disposalMethod          String? // AST-031: method of data destruction (e.g., degaussing, shredding)
  disposalResponsible     String? // AST-031: person responsible for disposal
  dataSource              String?
  lastDetectedAt          DateTime?
  status                  String    @default("active")
  version                 String    @default("1.0.0")
  isArchived              Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?
  updatedBy               String?

  assetType        AssetType         @relation("AssetTypeRelation", fields: [assetTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assetSubtype     AssetSubtype?     @relation(fields: [assetSubtypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizationUnit OrganizationUnit? @relation("AssetOrgUnit", fields: [organizationUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location         Site?             @relation("AssetLocation", fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  sourceRelations AssetRelation[] @relation("AssetSource")
  targetRelations AssetRelation[] @relation("AssetTarget")

  risks    Risk[]    @relation("AssetRisks")
  controls Control[] @relation("AssetControls")

  // Documents and evidence (AST-002)
  documents AssetDocument[]

  // Vulnerability/Incident relations (AST-002 gap)
  vulnerabilities VulnerabilityAsset[]
  incidents       IncidentAsset[]
  riskAssets      RiskAsset[]

  // Network addresses (normalized from comma-separated string)
  networkAddresses NetworkAddress[]

  // Generic import framework (Paket 2.3)
  importRecords   ImportRecord[]
  fieldProvenance FieldProvenance[]
  fieldLocks      FieldLock[]
  costPlanItems   CostPlanItem[]

  // Junction table links for M:N relationships
  processLinks  AssetProcess[]
  serviceLinks  AssetService[]
  contractLinks AssetContract[]
  licenseLinks  AssetLicense[]
  ControlAsset  ControlAsset[]

  @@map("assets")
}

model AssetRelation {
  id               String   @id @default(uuid())
  sourceAssetId    String
  targetAssetId    String
  relationshipType String
  description      String?
  createdAt        DateTime @default(now())
  createdBy        String?

  sourceAsset Asset @relation("AssetSource", fields: [sourceAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetAsset Asset @relation("AssetTarget", fields: [targetAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("asset_relations")
}

// Normalized network addresses (replaces comma-separated string in Asset)
model NetworkAddress {
  id        String   @id @default(uuid())
  assetId   String
  address   String // IP, CIDR, or hostname
  type      String // ipv4, ipv6, cidr, hostname
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assetId])
  @@map("network_addresses")
}

// ==========================================
// Generic Import Framework (Paket 2.3)
// ==========================================

model IntegrationSource {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  config    String     @default("{}") @db.NVarChar(Max)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  importRuns       ImportRun[]
  sourcePriorities SourcePriority[]
  fieldProvenance  FieldProvenance[]

  @@index([type])
  @@index([isActive])
  @@map("integration_sources")
}

model ImportRun {
  id                  String    @id @default(uuid())
  integrationSourceId String
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  status              String    @default("running") // running, completed, completed_with_conflicts, failed, dry_run
  dryRun              Boolean   @default(false)
  statistics          String      @default("{}") @db.NVarChar(Max)
  errorMessage        String?
  createdBy           String?

  integrationSource IntegrationSource @relation(fields: [integrationSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  records           ImportRecord[]
  conflicts         ImportConflict[]

  @@index([integrationSourceId])
  @@index([status])
  @@index([startedAt])
  @@map("import_runs")
}

model ImportRecord {
  id             String   @id @default(uuid())
  importRunId    String
  sourceRecordId String
  sourceHash     String
  sourceData     String @default("{}") @db.NVarChar(Max)
  targetAssetId  String?
  status         String   @default("pending") // created, updated, unchanged, conflict, skipped, error, stale_candidate
  action         String? // create, update, none, conflict, skipped
  message        String?
  createdAt      DateTime @default(now())

  importRun   ImportRun        @relation(fields: [importRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetAsset Asset?           @relation(fields: [targetAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conflicts   ImportConflict[]

  @@unique([importRunId, sourceRecordId])
  @@index([targetAssetId])
  @@index([status])
  @@map("import_records")
}

model ImportConflict {
  id             String    @id @default(uuid())
  importRunId    String
  importRecordId String?
  assetId        String?
  fieldName      String
  existingValue  String? @db.NVarChar(Max)
  incomingValue  String? @db.NVarChar(Max)
  winningValue   String? @db.NVarChar(Max)
  status         String    @default("open") // open, resolved, ignored
  resolution     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  importRun    ImportRun     @relation(fields: [importRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importRecord ImportRecord? @relation(fields: [importRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([importRunId])
  @@index([assetId])
  @@index([status])
  @@map("import_conflicts")
}

model FieldProvenance {
  id                  String   @id @default(uuid())
  assetId             String
  fieldName           String
  integrationSourceId String
  importRunId         String?
  sourceRecordId      String?
  value               String? @db.NVarChar(Max)
  setAt               DateTime @default(now())
  setBy               String?

  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  integrationSource IntegrationSource @relation(fields: [integrationSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, fieldName])
  @@index([integrationSourceId])
  @@index([importRunId])
  @@map("field_provenance")
}

model FieldLock {
  id        String   @id @default(uuid())
  assetId   String
  fieldName String
  reason    String?
  lockedBy  String
  lockedAt  DateTime @default(now())
  isActive  Boolean  @default(true)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assetId, fieldName])
  @@index([assetId])
  @@index([isActive])
  @@map("field_locks")
}

model SourcePriority {
  id                  String   @id @default(uuid())
  integrationSourceId String
  fieldName           String
  priority            Int      @default(100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  integrationSource IntegrationSource @relation(fields: [integrationSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([integrationSourceId, fieldName])
  @@index([fieldName, priority])
  @@map("source_priorities")
}

// ==========================================
// Risk Management
// ==========================================

model RiskMethod {
  id                   String   @id @default(uuid())
  displayId            String   @unique
  name                 String
  description          String?
  version              String
  likelihoodScale      String @default("{}") @db.NVarChar(Max) // configurable scale definition
  impactScale          String @default("{}") @db.NVarChar(Max) // configurable scale definition
  ratingDimensions     String @default("{}") @db.NVarChar(Max) // configurable dimensions
  calculationType      String   @default("product") // product, sum, max, matrix
  formulaExpression    String? // safe expression for custom calculations (deprecated in favor of calculationType)
  riskClasses          String @default("{}") @db.NVarChar(Max) // risk class definitions
  acceptanceThresholds String? @db.NVarChar(Max) // acceptable risk thresholds
  escalationThresholds String? @db.NVarChar(Max) // escalation triggers (RSK-022)
  approvalRules        String? @db.NVarChar(Max) // RSK-021: approval rules for acceptance
  reviewInterval       Int? // days between reviews
  isActive             Boolean  @default(true)
  isArchived           Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  versions RiskMethodVersion[]

  @@index([name, version])
  @@map("risk_methods")
}

// Immutable snapshot of a risk method at a point in time.
// Once created and referenced by assessments, it MUST NOT be modified.
model RiskMethodVersion {
  id                String   @id @default(uuid())
  riskMethodId      String
  versionTag        String // e.g. "2.0.0-snapshot-1" — auto-generated immutable tag
  likelihoodScale   String @default("{}") @db.NVarChar(Max) // snapshot of scale at this version
  impactScale       String @default("{}") @db.NVarChar(Max) // snapshot of scale at this version
  ratingDimensions  String @default("{}") @db.NVarChar(Max) // snapshot of dimensions
  calculationType   String   @default("product") // product, sum, max, matrix
  formulaExpression String? // safe expression (deprecated)
  riskClasses       String @default("{}") @db.NVarChar(Max) // threshold definitions for class classification
  createdAt         DateTime @default(now())
  isImmutable       Boolean  @default(false) // set to true once first assessment references this version

  riskMethod             RiskMethod              @relation(fields: [riskMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Risk                   Risk[]
  riskAssessmentVersions RiskAssessmentVersion[]

  @@index([riskMethodId])
  @@map("risk_method_versions")
}

model Risk {
  id                      String   @id @default(uuid())
  displayId               String   @unique
  title                   String
  description             String
  organizationUnitId      String?
  // affectedAssetIds removed — use RiskAsset junction table only
  // affectedProcessIds removed — use RiskProcess junction table
  // affectedServiceIds removed — use RiskService junction table
  threatId                String? // Legacy FK — prefer scenarioId for relational approach
  vulnerabilityId         String? // Legacy FK — prefer scenarioId for relational approach
  possibleImpact          String
  likelihood              Int
  impact                  Int
  inherentRisk            String
  residualRisk            String
  targetRisk              String
  riskOwnerId             String
  assessorId              String
  assessmentDate          DateTime @default(now())
  nextReviewDate          DateTime
  evaluationJustification String?
  businessProcessId       String?
  status                  String   @default("identified")
  version                 String   @default("1.0.0")
  riskMethodVersionId     String? // FK to RiskMethodVersion — binds assessment to a concrete method version
  scenarioId              String? // Relational reference to RiskScenario
  isArchived              Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdBy               String?
  updatedBy               String?

  organizationUnit  OrganizationUnit?  @relation("RiskOrgUnit", fields: [organizationUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets            Asset[]            @relation("AssetRisks")
  businessProcess   BusinessProcess?   @relation("ProcessRisks", fields: [businessProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  riskControls      RiskControl[]
  riskAssets        RiskAsset[]
  treatments        RiskTreatment[]
  riskMethodVersion RiskMethodVersion? @relation(fields: [riskMethodVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Relational risk building blocks (Paket 3.2)
  scenario      RiskScenario?    @relation(fields: [scenarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  threat        Threat?          @relation(fields: [threatId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vulnerability Vulnerability?   @relation(fields: [vulnerabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  causes        RiskCauseLink[]
  impacts       RiskImpactLink[]
  reviewTasks   ReviewTask[]

  // Junction table links for M:N relationships (replaces ID arrays)
  processLinks           RiskProcess[]
  serviceLinks           RiskService[]
  riskAssessmentVersions RiskAssessmentVersion[]

  @@index([riskMethodVersionId])
  @@index([scenarioId])
  @@map("risks")
}

model RiskAssessmentVersion {
  id                  String    @id @default(uuid())
  riskId              String
  riskMethodVersionId String
  versionNumber       Int       @default(1)
  assessmentType      String    @default("current")
  likelihood          Int
  impact              Int
  inherentRisk        String
  residualRisk        String
  targetRisk          String
  score               Int?
  assessorId          String
  assessedAt          DateTime  @default(now())
  nextReviewDate      DateTime
  justification       String
  status              String    @default("draft")
  isCurrent           Boolean   @default(true)
  isClosed            Boolean   @default(false)
  closedAt            DateTime?
  createdAt           DateTime  @default(now())

  risk                   Risk                    @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  riskMethodVersionIdRef RiskMethodVersion       @relation(fields: [riskMethodVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  controlAssessments     RiskControlAssessment[]
  acceptances            RiskAcceptance[]

  @@unique([riskId, versionNumber])
  @@index([riskId, isCurrent])
  @@index([riskId, assessmentType, isCurrent])
  @@index([assessmentType])
  @@map("risk_assessment_versions")
}

model RiskControl {
  id                      String                         @id @default(uuid())
  riskId                  String
  controlImplementationId String
  role                    String
  mitigationDimension     String
  isKeyControl            Boolean                        @default(false)
  status                  String                         @default("active")
  createdAt               DateTime                       @default(now())
  createdBy               String?

  risk                  Risk                    @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  controlImplementation ControlImplementation   @relation(fields: [controlImplementationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessments           RiskControlAssessment[]

  @@unique([riskId, controlImplementationId])
  @@index([riskId])
  @@index([controlImplementationId])
  @@map("risk_controls")
}

model RiskControlAssessment {
  id                      String    @id @default(uuid())
  riskControlId           String
  riskAssessmentVersionId String
  effectivenessStatus     String
  effectivenessRating     Int?
  likelihoodReduction     Int?
  impactReduction         Int?
  justification           String
  assessedBy              String
  assessedAt              DateTime  @default(now())
  status                  String    @default("draft")
  isClosed                Boolean   @default(false)
  closedAt                DateTime?

  riskControl           RiskControl           @relation(fields: [riskControlId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  riskAssessmentVersion RiskAssessmentVersion @relation(fields: [riskAssessmentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evidenceLinks         EvidenceLink[]

  @@unique([riskControlId, riskAssessmentVersionId])
  @@index([riskAssessmentVersionId])
  @@map("risk_control_assessments")
}

model RiskTreatment {
  id                   String    @id @default(uuid())
  displayId            String    @unique
  riskId               String
  assessmentId         String?
  treatmentOption      String // avoid, reduce, transfer, accept
  plannedActions       String?
  responsibleUserId    String?
  budget               Decimal?
  targetDate           DateTime?
  expectedReduction    String?
  dependencies         String?
  implementationStatus String    @default("planned")
  effectivenessReview  String?
  completionApproval   String?
  justification        String? // required for acceptance
  expiryDate           DateTime? // RSK-023: acceptance cannot be unlimited
  approvedByUserId     String?
  completedAt          DateTime?
  completedBy          String?
  residualAssessmentId String?
  isArchived           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  risk                 Risk                               @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acceptance           RiskAcceptance?
  approvals            RiskTreatmentApproval[]
  effectivenessReviews RiskTreatmentEffectivenessReview[]
  actions              TreatmentAction[]

  @@index([riskId])
  @@index([assessmentId])
  @@map("risk_treatments")
}

model TreatmentAction {
  id                      String    @id @default(uuid())
  treatmentId             String
  controlImplementationId String?
  actionType              String
  title                   String
  description             String?
  responsibleUserId       String?
  targetDate              DateTime?
  status                  String    @default("planned")
  completedAt             DateTime?
  completedBy             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?

  treatment             RiskTreatment          @relation(fields: [treatmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  controlImplementation ControlImplementation? @relation(fields: [controlImplementationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([treatmentId])
  @@index([controlImplementationId])
  @@map("treatment_actions")
}

model RiskAcceptance {
  id              String    @id @default(uuid())
  treatmentId     String    @unique
  riskId          String
  assessmentId    String
  justification   String
  expiryDate      DateTime
  requestedBy     String
  requiredLevel   String // risk_owner, management
  status          String    @default("pending") // pending, approved, rejected, expired, revoked
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  treatment  RiskTreatment         @relation(fields: [treatmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assessment RiskAssessmentVersion @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([riskId])
  @@index([assessmentId])
  @@index([status])
  @@map("risk_acceptances")
}

model RiskTreatmentApproval {
  id            String   @id @default(uuid())
  treatmentId   String
  approverId    String
  approvalLevel String // risk_owner, management
  decision      String // approved, rejected
  comment       String?
  decidedAt     DateTime @default(now())

  treatment RiskTreatment @relation(fields: [treatmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([treatmentId])
  @@index([approverId])
  @@map("risk_treatment_approvals")
}

model RiskTreatmentEffectivenessReview {
  id          String   @id @default(uuid())
  treatmentId String
  result      String
  reviewDate  DateTime
  reviewerId  String
  notes       String?
  createdAt   DateTime @default(now())

  treatment RiskTreatment @relation(fields: [treatmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([treatmentId])
  @@index([reviewerId])
  @@map("risk_treatment_effectiveness_reviews")
}

model Threat {
  id          String   @id @default(uuid())
  displayId   String   @unique
  name        String
  description String
  category    String
  source      String?
  status      String   @default("active")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  // Risks referencing this threat (via Scenario or directly)
  scenarios RiskScenario[]
  risks     Risk[]

  @@map("threats")
}

model Vulnerability {
  id          String   @id @default(uuid())
  displayId   String   @unique
  name        String
  description String
  category    String
  severity    String   @default("low")
  cveId       String?
  cvssScore   Decimal?
  status      String   @default("active")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  assets    VulnerabilityAsset[]
  scenarios RiskScenario[]
  risks     Risk[]

  @@map("vulnerabilities")
}

// Scenario describes a concrete risk scenario combining threat + vulnerability context.
model RiskScenario {
  id              String   @id @default(uuid())
  displayId       String   @unique
  title           String
  description     String?
  threatId        String
  vulnerabilityId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  threat        Threat         @relation(fields: [threatId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vulnerability Vulnerability? @relation(fields: [vulnerabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  risks         Risk[]

  @@index([threatId])
  @@map("risk_scenarios")
}

// Cause represents a root cause contributing to the risk.
model RiskCause {
  id          String   @id @default(uuid())
  displayId   String   @unique
  title       String
  description String?
  category    String? // technical, organizational, human, environmental
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  risks RiskCauseLink[]

  @@map("risk_causes")
}

// Impact represents a concrete business/technical impact of the risk.
model RiskImpact {
  id          String   @id @default(uuid())
  displayId   String   @unique
  title       String
  description String?
  category    String? // confidentiality, integrity, availability, financial, reputational, legal, safety
  severity    String   @default("low") // low, medium, high, very_high
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?

  risks RiskImpactLink[]

  @@map("risk_impacts")
}

// Junction: Risk <-> Cause (M:N)
model RiskCauseLink {
  id      String @id @default(uuid())
  riskId  String
  causeId String

  risk  Risk      @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cause RiskCause @relation(fields: [causeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([riskId, causeId])
  @@map("risk_cause_links")
}

// Junction: Risk <-> Impact (M:N)
model RiskImpactLink {
  id       String @id @default(uuid())
  riskId   String
  impactId String

  risk   Risk       @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  impact RiskImpact @relation(fields: [impactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([riskId, impactId])
  @@map("risk_impact_links")
}

// ReviewTask represents a scheduled or ad-hoc risk review task.
model ReviewTask {
  id             String    @id @default(uuid())
  displayId      String    @unique
  riskId         String
  scheduledDate  DateTime
  dueDate        DateTime
  status         String    @default("pending") // pending, in_progress, completed, overdue, cancelled
  priority       String    @default("medium") // low, medium, high, critical
  assignedTo     String? // user ID of reviewer/owner
  triggerType    String    @default("scheduled") // scheduled, unplanned_event, ad_hoc
  triggerEventId String? // reference to the triggering event (incident, change, etc.)
  triggerSource  String? // human-readable source description
  notes          String?
  completedAt    DateTime?
  completedBy    String?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?

  risk Risk @relation(fields: [riskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([riskId])
  @@index([status])
  @@index([dueDate])
  @@index([assignedTo])
  @@map("review_tasks")
}

// ==========================================
// Generic Document model (for AssetDocument junction)
