  changedByUserId  String?
  reason           String?
  disposalEvidence String? // AST-031: data destruction proof

  @@map("asset_lifecycle_logs")
}

// ==========================================
// VMware vCenter Integration Models
// ==========================================

model VmwareCredential {
  id                String   @id @default(uuid())
  name              String
  username          String
  passwordEncrypted String
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vCenters VCenterServer[]

  @@map("vmware_credentials")
}

model VCenterServer {
  id             String    @id @default(uuid())
  name           String
  host           String
  port           Int       @default(443)
  credentialId   String
  enabled        Boolean   @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastSyncError  String?
  vmCount        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  credential VmwareCredential @relation(fields: [credentialId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([host, port])
  @@index([credentialId])
  @@map("vcenter_servers")
}

// Proxmox Credential - shared credentials for PVE
model ProxmoxCredential {
  id                String   @id @default(uuid())
  name              String
  username          String // e.g., 'admin@pam' or API token user
  passwordEncrypted String? // encrypted password (or use API token)
  apiToken          String? // alternative: API token value encrypted
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  proxmoxServers ProxmoxServer[]

  @@map("proxmox_credentials")
}

// Proxmox Server configuration
model ProxmoxServer {
  id             String    @id @default(uuid())
  name           String
  host           String // FQDN or IP of PVE
  port           Int       @default(8006)
  nodeId         String? // specific node to import from (null = all nodes)
  credentialId   String
  enabled        Boolean   @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String? // success, error, pending
  lastSyncError  String?
  vmCount        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  credential ProxmoxCredential @relation(fields: [credentialId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([host, port, nodeId])
  @@index([credentialId])
  @@map("proxmox_servers")
}

// ==========================================
// Phase 8: API, Betrieb und Nachweise
// ==========================================

model ServiceAccount {
  id              String    @id @default(uuid())
  displayId       String    @unique @default("")
  name            String
  description     String?
  userId          String?
  accessTokenHash String
  accessTokenSalt String
  scopes          String      @default("[]") @db.NVarChar(Max)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  isArchived      Boolean   @default(false)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?

  user            User?            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiAuditLogs    ApiAuditLog[]
  idempotencyKeys IdempotencyKey[]

  @@index([isActive])
  @@index([isArchived])
  @@map("service_accounts")
}

model ApiAuditLog {
  id               String   @id @default(uuid())
  correlationId    String
  serviceAccountId String?
  userId           String?
  method           String
  path             String
  statusCode       Int?
  requestSize      BigInt   @default(0)
  responseSize     BigInt   @default(0)
  durationMs       Int?
  ipAddress        String?
  userAgent        String?
  idempotencyKey   String?
  errorMessage     String?
  createdAt        DateTime @default(now())

  serviceAccount ServiceAccount? @relation(fields: [serviceAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([correlationId])
  @@index([serviceAccountId])
  @@index([createdAt])
  @@map("api_audit_logs")
}

model IdempotencyKey {
  key                 String   @id @default(uuid())
  serviceAccountId    String
  userId              String?
  httpMethod          String
  routePattern        String
  requestBodyHash     String
  responseStatus      Int
  responseHeaders     String     @default("{}") @db.NVarChar(Max)
  responseBodyPreview String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  serviceAccount ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt])
  @@index([serviceAccountId])
  @@map("idempotency_keys")
}

model Webhook {
  id                 String        @id @default(uuid())
  displayId          String        @unique @default("")
  name               String
  description        String?
  url                String
  secret             String // HMAC signing secret for this webhook
  events             String @default("[]") @db.NVarChar(Max)      @db.NVarChar(Max)
  status             String @default(active)
  isActive           Boolean       @default(true)
  isArchived         Boolean       @default(false)
  lastDeliveryStatus String? // "success" | "failed"
  lastDeliveredAt    DateTime?
  failureCount       Int           @default(0)
  maxRetries         Int           @default(5)
  timeoutMs          Int           @default(10000)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdBy          String?
  updatedBy          String?

  deliveries WebhookDelivery[]
  attempts   WebhookDeliveryAttempt[]

  @@index([status, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id              String                @id @default(uuid())
  webhookId       String
  eventId         String                // idempotency key (unique constraint dropped by migration 20260805150000)
  eventType       String
  payload         String                @db.NVarChar(Max) // JSON-serialized payload
  signature       String? // HMAC signature sent with delivery
  url             String
  httpMethod      String                @default("POST")
  requestHeaders  String                @default("{}") @db.NVarChar(Max)
  requestBodyHash String?
  responseStatus  Int?
  responseHeaders String?               @db.NVarChar(Max)
  errorMessage    String?
  durationMs      Int?
  attemptNumber   Int                   @default(1)
  status          String @default(pending)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  webhook  Webhook                  @relation(fields: [webhookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attempts WebhookDeliveryAttempt[]

  @@index([webhookId, status])
  @@index([status])
  @@index([eventId])
  @@unique([webhookId, eventId, attemptNumber]) // added by migration 20260805170000
  @@map("webhook_deliveries")
}

model WebhookDeliveryAttempt {
  id              String   @id @default(uuid())
  deliveryId      String
  webhookId       String
  eventPayloadId  String
  eventType       String
  payload         String   @db.NVarChar(Max)
  attemptNumber   Int
  status          String
  errorMessage    String?
  responseStatus  Int?
  responseHeaders String?  @db.NVarChar(Max)
  durationMs      Int?
  startedAt       DateTime
  completedAt     DateTime

  webhook  Webhook         @relation(fields: [webhookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([webhookId, status])
  @@index([deliveryId])
  @@index([status])
  @@map("webhook_delivery_attempts")
}

model ApiRateLimit {
  id                String   @id @default(uuid())
  serviceAccountId  String?
  userId            String?
  endpointPattern   String   @default("*")
  requestsPerMinute Int      @default(60)
  requestsPerHour   Int      @default(1000)
  burstSize         Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([serviceAccountId])
  @@index([userId])
  @@map("api_rate_limits")
}

model ApiScope {
  scope       String   @id
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())

  @@map("api_scopes")
}

model ControlCatalog {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  version     String?
  url         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ControlCatalogItem[]

  @@map("control_catalogs")
}

model ControlCatalogItem {
  id          String   @id @default(uuid())
  catalogId   String
  controlId   String
  title       String
  description String?
  controlText String?
  category    String?
  subcategory String?
  sortOrder   Int?
  tags        String @default("[]") @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalog ControlCatalog @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([catalogId, controlId])
  @@index([catalogId])
  @@map("control_catalog_items")
}

// ==========================================
// Phase 10: Background Jobs Cluster-Safety
// ==========================================

model JobRun {
  id          String    @id @default(uuid())
  jobId       String // logical job identifier, e.g. "intune-full-sync"
  jobType     String // category: "sync", "reminder", "webhook-retry", "import"
  status      String    @default("pending") // pending | running | completed | failed | skipped
  workerId    String? // hostname + pid or container id
  scheduledAt DateTime? // null means run immediately
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?   @db.NVarChar(Max)
  attempt     Int       @default(1)
  data        String?   @db.NVarChar(Max) // JSON-serialized job payload
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([jobType, status])
  @@index([scheduledAt])
  @@map("job_runs")
}

model JobLease {
  id          String   @id @default(uuid())
  jobName     String   @unique
  ownerId     String
  leaseUntil  DateTime
  heartbeatAt DateTime
  acquiredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leaseUntil])
  @@index([ownerId])
  @@map("job_leases")
}
