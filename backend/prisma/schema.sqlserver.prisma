  requirementText    String
  section            String?
  clauseNumber       String?
  parentKey          String?
  sortOrder          Int?
  licenseNotice      String?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

