# Server Configuration
NODE_ENV=development
PORT=3001
# Bind address. Defaults to 127.0.0.1 (loopback) for defense in depth.
# Set HOST=0.0.0.0 only when the backend must be reachable from other hosts.
HOST=0.0.0.0
# Frontend dev uses port 3000. Do not set backend PORT=3000 unless you also set
# ALLOW_BACKEND_FRONTEND_PORT_CONFLICT=true intentionally for a non-standard setup.
#
# Proxy trust (rate limiting + audit IP accuracy behind a reverse proxy/LB):
#   TRUST_PROXY=1      → trust exactly one proxy hop (default when unset)
#   TRUST_PROXY=2      → trust two hops (CDN → LB → app)
#   TRUST_PROXY=false  → disabled (direct connections, local dev)
# "true" is accepted for compatibility and explicitly resolved to the number 1 —
# never to boolean true, which would trust a client-spoofable X-Forwarded-For entry.
TRUST_PROXY=1

# Database
# Supported values: postgresql, sqlserver.
# Prisma schema generation is provider-specific. PostgreSQL uses
# prisma/schema.prisma. SQL Server uses generated prisma/schema.sqlserver.prisma,
# where Json and scalar-list fields are stored as NVARCHAR(MAX) JSON text.
DB_PROVIDER=postgresql

# Store credentials in environment variables or in an ignored local secret file.
# Do not commit real credentials. DATABASE_URL_FILE takes precedence when set.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/asset_management?schema=public"
# DATABASE_URL_FILE=./secrets/database-url.txt

# Microsoft SQL Server example placeholder:
# DB_PROVIDER=sqlserver
# DATABASE_URL="sqlserver://localhost:1433;database=asset_management;user=asset_user;password=<password>;encrypt=true;trustServerCertificate=false"

# JWT Configuration
# WICHTIG: JWT_SECRET ist ZWINGEND erforderlich!
# Die Anwendung startet NICHT ohne einen explizit gesetzten JWT_SECRET.
# Verwenden Sie einen kryptografisch sicheren Zufallswert (mind. 32 Zeichen).
# Beispiel: openssl rand -hex 32
# Kein Fallback auf Default-Werte - bei Fehlen wird der Start abgebrochen.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=20m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_SAME_SITE=lax

# CORS
CORS_ORIGINS=http://localhost:3000
# Global parsed request body size in bytes; valid range is 1..52428800 (default: 10485760).
REQUEST_BODY_LIMIT_BYTES=10485760
# Maximum URL-encoded fields accepted in one request (default: 100, max: 1000).
URL_ENCODED_PARAMETER_LIMIT=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth endpoint limiter (window shared with above, default 20 req / 15 min)
AUTH_RATE_LIMIT_MAX=20
# Refresh-token endpoint limiter (default 120 req / window)
REFRESH_RATE_LIMIT_MAX=120
# Service-account credential verification limiter (default: 60 req / 15 min).
SERVICE_ACCOUNT_AUTH_RATE_LIMIT_MAX=60

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
# Database backup import size limit in MB (default 50)
BACKUP_MAX_FILE_SIZE_MB=50

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# ==========================================
# Intune Integration Configuration
# ==========================================

# Enable/disable Intune sync (true/false or 1/0)
INTUNE_ENABLED=false

# Microsoft Entra ID (Azure AD) Tenant ID
INTUNE_TENANT_ID=

# App (Client) ID registered in Entra ID
INTUNE_APP_ID=

# SecretStore reference for PEM private key, no defaults allowed.
# Supported providers: env:VARIABLE_NAME or file:relative-or-absolute-path
INTUNE_CERT_PRIVATE_KEY_SECRET_REF=

# Optional SecretStore reference for x5c public certificate chain.
INTUNE_CERT_X5C_SECRET_REF=

# Certificate thumbprint (for token signing verification)
INTUNE_CERT_THUMBPRINT=

# Display name for devices created by this integration
INTUNE_APP_NAME=Asset-Management

# Full sync interval in hours (default: 24, range: 1-168)
INTUNE_FULL_SYNC_INTERVAL=24

# Incremental sync interval in minutes (default: 120, range: 10-1440)
INTUNE_INCREMENTAL_SYNC_INTERVAL=120

# Grace period in hours before stale/review marking, never auto-archiving (default: 168 = 7 days)
INTUNE_GRACE_PERIOD_HOURS=168

# Max retry attempts for API requests (default: 3, range: 1-10)
INTUNE_MAX_RETRY_ATTEMPTS=3

# Base retry delay in milliseconds (default: 5000)
INTUNE_RETRY_DELAY_MS=5000

# Batch size for sync operations (default: 100)
INTUNE_BATCH_SIZE=100

# ==========================================
# VMware vCenter Integration Configuration
# ==========================================

# Encryption key for VMware credentials (AES-256-GCM, must be EXACTLY 32
# characters). REQUIRED when creating/reading VMware credentials — the service
# fails closed without it. Legacy AES-256-CBC values remain decryptable.
# Generate with: openssl rand -hex 16
VMWARE_ENCRYPTION_KEY=your-32-byte-encryption-key-here!!

# ==========================================
# Proxmox VE Integration Configuration
# ==========================================

# Encryption key for Proxmox credentials (AES-256-GCM, must be EXACTLY 32
# characters). REQUIRED when creating/reading Proxmox credentials — the
# service fails closed without it. Legacy AES-256-CBC values remain decryptable.
# Note: values written by older versions were encrypted with VMWARE_ENCRYPTION_KEY;
# if such data exists, set this key to the SAME value to decrypt it.
# Generate with: openssl rand -hex 16
PROXMOX_ENCRYPTION_KEY=

# ==========================================
# Health & Metrics Configuration (Phase 11)
# ==========================================

# Metrics token for /metrics endpoint protection.
# If set, requires ?token=<value> or Authorization: Bearer <token>.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=

# Timeout in milliseconds for health check database queries (default: 5000)
HEALTH_CHECK_NETWORK_TIMEOUT_MS=5000

# ==========================================
# Webhook Configuration
# ==========================================

# Inbound shared secret accepted via the X-Webhook-Secret header (simple
# integrations). Bearer tokens (service accounts) are the recommended mode.
# WEBHOOK_SIGNATURE_SECRET takes precedence; WEBHOOK_SECRET is accepted as a
# legacy fallback name.
WEBHOOK_SIGNATURE_SECRET=
# WEBHOOK_SECRET=

# Maximum allowed age for webhook signatures (milliseconds).
# Default: 300000 (5 minutes). Signatures older than this are rejected.
WEBHOOK_SIGNATURE_MAX_AGE_MS=300000

# Webhook queue polling interval in milliseconds.
# Default: 5000 (5 seconds).
WEBHOOK_QUEUE_POLL_INTERVAL_MS=5000

# ==========================================
# MFA (TOTP) Secret Encryption
# ==========================================

# Encryption key for stored MFA (TOTP) secrets (AES-256-GCM).
# If unset, the MFA secret is derived from JWT_SECRET, which couples two
# security-critical values to one secret. Setting a dedicated key is strongly
# recommended.
# MFA_ENCRYPTION_KEY=

# ==========================================
# Distributed Idempotency (Redis)
# ==========================================

# Redis host for distributed idempotency key storage.
# If set, the idempotency middleware uses Redis for cross-process
# atomicity (first-write-wins via SET NX).
# If not set, only the in-memory store is used.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
