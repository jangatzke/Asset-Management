{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0 && node scripts/check-design-tokens.cjs",
    "lint:ci": "npm run lint",
    "lint:tokens": "node scripts/check-design-tokens.cjs",
    "lint:tokens:update": "node scripts/check-design-tokens.cjs --update-baseline",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=github,list,html",
    "e2e:list": "playwright test --list",
    "e2e:typecheck": "tsc --noEmit -p tsconfig.playwright.json",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.0.0",
    "@heroicons/react": "^2.1.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "axios": "^1.6.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.2",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.17",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.5"
  }
}
