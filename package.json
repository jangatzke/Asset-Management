{
  "name": "asset-management-isms",
  "version": "1.0.0",
  "private": true,
  "description": "IT-Asset-Management und ISMS-System nach ISO 27001:2022, NIS-2 und BSI-Gesetz",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "postinstall": "node -e \"const fs=require('fs');process.exit(fs.existsSync('backend/package.json')?0:1)\" && npm run db:generate --workspace backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace shared && npm run build --workspace backend && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "requirements-check": "tsx scripts/check-requirements.ts",
    "vulnerability-check": "tsx scripts/check-vulnerabilities.ts",
    "openapi:check": "node scripts/check-openapi-coverage.js"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "7.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "express-rate-limit": "^8.7.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "nodemailer": "^10.2.1",
    "braces": "^3.0.3",
    "follow-redirects": "^1.16.2",
    "ip-address": "^10.7.5",
    "qs": "^6.17.0"
  }
}
